# Server
PORT=5174
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
DB_PATH=server/data/app.db

# Razorpay — leave blank to run in offline mode (bookings work, payment is skipped)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exposed to the browser by Vite. Must be the same key id as above.
VITE_RAZORPAY_KEY_ID=

# Set to false when serving over plain HTTP (e.g. testing on your LAN).
# Leave unset — or true — once the site is behind HTTPS.
COOKIE_SECURE=
# Interface the API binds to. 0.0.0.0 (default) allows other devices on your network.
HOST=0.0.0.0
